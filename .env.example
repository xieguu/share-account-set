RELAY_HOST=127.0.0.1
RELAY_PORT=3410
RELAY_ORIGIN=http://127.0.0.1:3410
# Comma-separated exact origins for separate frontends, e.g. https://xieguu.github.io
RELAY_FRONTEND_ORIGINS=
# Operator-approved private HTTP(S) origins, comma-separated; empty denies private networks.
RELAY_TRUSTED_NETWORK_ORIGINS=
# Only for a server on numeric loopback during local Agent development. Production uses HTTPS.
RELAY_AGENT_INSECURE_LOOPBACK=false
RELAY_DATA_DIR=./data
RELAY_ADMIN_USER=admin
RELAY_ADMIN_PASSWORD=replace-with-a-long-random-password
RELAY_HEADLESS=true
RELAY_BROWSER_CHANNEL=
RELAY_IDLE_MINUTES=15
RELAY_MAX_CONTEXTS=6
RELAY_LAB=true
RELAY_LAB_PORT=3411
